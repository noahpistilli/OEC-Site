---
interface NavItem {
    label: string;
    href: string;
}

interface Props {
    scrollEffect?: boolean;
    currentPage?: string;
}

const navItems = [
    { label: "Home", href: "/" },
    { label: "About", href: "/#about" },
    { label: "Map", href: "/map" },
    { label: "Resources", href: "/resources" },
    { label: "Competitions", href: "/#competitions" },
    { label: "Sponsors", href: "/#sponsors" },
];

const { scrollEffect = false, currentPage = "" } = Astro.props;
---

<div class="w-full max-w-[1650px] flex items-start left-1/2 -translate-x-1/2 fixed z-50">
    <nav id="navbar" class:list={[
        "w-full top-0 m-3 left-0 z-50 p-4 rounded-full border-2 border-white/10 transition-all duration-300",
        { "bg-white": !scrollEffect },
        { "bg-white": scrollEffect }
    ]}>
        <div class="flex items-center justify-between gap-6">
            <img src="/img/oec_logo_color.png" alt="OEC Logo" class="h-16 w-16" />
            <ul class="flex items-center gap-4 list-none m-0 p-0">
                {navItems.map((item) => (
                    <li>
                        <a 
                            href={item.href}
                            class:list={[
                                "text-gray-800 font-medium no-underline px-3 py-1 rounded-full transition-colors hover:bg-blue-100 hover:text-blue-600",
                                { "bg-blue-500 text-white": currentPage === item.label }
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </nav>
</div>

{scrollEffect && (
    <script>
        const navbar = document.getElementById('navbar');
        
        window.addEventListener('scroll', () => {
            if (window.scrollY > window.innerHeight) {
                navbar.classList.remove('bg-white');
                navbar.classList.add('bg-white/20', 'backdrop-blur-xl');
            } else {
                navbar.classList.remove('bg-white/20', 'backdrop-blur-xl');
                navbar.classList.add('bg-white');
            }
        }, { passive: true });
    </script>
)}

<script>
    const anchors = [...document.querySelectorAll('#navbar a[href*="#"]')];

    const sections = anchors
        .map((link) => {
            const id = link.getAttribute("href").split("#")[1];
            return { link, el: document.getElementById(id) };
        })
        .filter(({ el }) => el);

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    sections.forEach(({ link, el }) => {
                        link.classList.toggle("!bg-blue-500/70", el === entry.target);
                        link.classList.toggle("!text-white", el === entry.target);
                    });
                }
            });
        },
        { threshold: 0.25 },
    );

    sections.forEach(({ el }) => observer.observe(el));
</script>
