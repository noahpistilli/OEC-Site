---
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/#about" },
  { label: "Map", href: "/map" },
  { label: "Resources", href: "/resources" },
  { label: "Competitions", href: "/#competitions" },
];
---

<footer class="w-full relative bg-[rgb(16,46,123)] text-white pt-12 pb-12 px-8 md:px-16 overflow-hidden">
  <div class="w-full bottom-0 left-0 absolute translate-x-[-4.5rem] translate-y-8 z-10">
    <img
      class="min-w-[1500px] footer-wave absolute bottom-0 left-0 will-change-transform backdrop-blur-md z-2 [mask-image:url(/img/Wave_1.svg)] [mask-size:100%_100%] [mask-repeat:no-repeat]"
      src="/img/Wave_1.svg"
    />
    <img
      class="min-w-[1500px] footer-wave absolute bottom-0 left-0 will-change-transform backdrop-blur-md z-2 [mask-image:url(/img/Wave_2.svg)] [mask-size:100%_100%] [mask-repeat:no-repeat]"
      src="/img/Wave_2.svg"
    />
    <img
      class="min-w-[1500px] footer-wave absolute bottom-0 left-0 will-change-transform backdrop-blur-md z-2 [mask-image:url(/img/Wave_3.svg)] [mask-size:100%_100%] [mask-repeat:no-repeat]"
      src="/img/Wave_3.svg"
    />
  </div>

  <div class="relative z-20 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-12">
      <div class="flex flex-col items-center md:items-start gap-4">
      <img src="/img/oec_logo.svg" alt="OEC Logo" class="w-20 h-20" />
      <h1 class="max-w-[300px] text-2xl md:text-3xl font-bold text-center md:text-left font-[Rubik]">
        Ontario Engineering Competition
      </h1>
      </div>
      <nav class="flex flex-col items-end gap-6">
        <ul class="flex items-center gap-6 list-none m-0 p-0">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-white/70 hover:text-white transition-colors no-underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-4 mt-4">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 hover:text-white transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 hover:text-white transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </nav>
    </div>

    <hr class="border-white/20 mb-8" />

    <p class="text-white/50 text-sm text-center">
      &copy; {new Date().getFullYear()} Ontario Engineering Competition. All rights reserved.
    </p>
  </div>
</footer>

<script>
  const footerWaves = document.querySelectorAll(".footer-wave");
  const footerMouseSpeeds = [0.04, 0.08, 0.12];
  const footerAutoSpeeds = [0.0008, 0.0012, 0.0018];
  const footerAmplitudes = [8, 14, 20];

  let footerMouseX = 0;
  let footerMouseY = 0;


  function animateFooter(time) {
    footerWaves.forEach((wave, i) => {
      const autoX = Math.sin(time * footerAutoSpeeds[i]) * footerAmplitudes[i];
      const autoY =
        Math.cos(time * footerAutoSpeeds[i] * 0.7) *
        (footerAmplitudes[i] * 0.5);
      const moveX = footerMouseX * footerMouseSpeeds[i] * 100 + autoX;
      const moveY = footerMouseY * footerMouseSpeeds[i] * 50 + autoY;
      wave.style.transform = `translate(${moveX}px, ${moveY}px)`;
    });
    requestAnimationFrame(animateFooter);
  }

  requestAnimationFrame(animateFooter);
</script>
