---
import { contentfulClient } from '../lib/contentful';

interface Sponsor {
  fields: {
    name: string;
    logo: {
      fields: {
        file: {
          url: string;
        };
      };
    };
    url: string;
  };
}

interface SponsorTier {
  fields: {
    name: string;
    sponsor: Sponsor[];
  };
}

const tiers = await contentfulClient.getEntries<SponsorTier>({
  content_type: 'sponsorTiers',
  include: 2,
});
---

<section class="w-full py-24 px-8 md:px-16 z-10 relative">
  <h2 class="text-blue-950 text-4xl md:text-5xl font-bold mb-16 font-[Rubik] relative z-10">
    Our Sponsors
  </h2>

  {tiers.items.map((tier) => (
    <div class="mb-16 last:mb-0 relative z-10">
      <h3 class="text-2xl md:text-3xl font-bold mb-8 text-black/60">
        {tier.fields.name}
      </h3>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mx-auto">
        {tier.fields.sponsor?.map((sponsor) => (
          <a
            href={sponsor.fields.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center p-6 hover:scale-110 transition-all duration-300"
          >
            <img
              src={`https:${sponsor.fields.logo.fields.file.url}`}
              alt={sponsor.fields.name}
              class="max-w-full object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
            />
          </a>
        ))}
      </div>
    </div>
  ))}
</section>
