---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import { Download } from "@lucide/astro";
---

<Layout siteTitle="Resources | Ontario Engineering Competition 2027">
    <Navbar currentPage="Resources" />
    <main class="min-h-screen max-w-7xl mx-auto px-8 md:px-16 pt-32 pb-24">
        <h1 class="text-4xl md:text-5xl font-bold font-[Rubik] text-blue-950 mb-12">
            RESOURCES
        </h1>

        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold font-[Rubik] text-blue-950">
                Emergency Contacts
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        Campus Security
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        On-campus emergencies or security assistance
                    </p>
                    <p class="text-2xl font-bold text-blue-950 mt-6">
                        416-979-5040 (ext. 555040 from any campus phone)
                    </p>
                    <p class="text-sm text-black/70 mt-1">
                        Available 24/7
                    </p>
                </div>
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        Emergency Services
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        For all life-threatening emergencies
                    </p>
                    <p class="text-2xl font-bold text-blue-950 mt-6">911</p>
                    <p class="text-sm text-black/70 mt-1">Available 24/7</p>
                </div>
            </div>
        </section>

        <section>
            <h2 class="mb-6 text-3xl font-bold font-[Rubik] text-blue-950">
                Additional Resources
            </h2>
            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        Linktree
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        Quick access to important links, including the incident report form and the live schedule for the weekend
                    </p>
                    <div class="mt-4">
                        <Button
                            href="https://linktr.ee/ontarioengcomp"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Download class="w-5 h-5" />
                            View / Download
                        </Button>
                    </div>
                </div>
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        Official Rulebook 2026
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        Official rules and regulations for all competition categories
                    </p>
                    <div class="mt-4">
                        <Button
                            href="/OEC_2026_Rulebook.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Download class="w-5 h-5" />
                            View / Download
                        </Button>
                    </div>
                </div>
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        Delegate Package
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        Outlines delegate information, including logistics, timelines, and emergency contacts
                    </p>
                    <div class="mt-4">
                        <Button
                            href="/OEC_2026_Delegate_Package.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Download class="w-5 h-5" />
                            View / Download
                        </Button>
                    </div>
                </div>
                <div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow p-6">
                    <h3 class="text-2xl font-semibold tracking-tight text-blue-950">
                        OEC Resources
                    </h3>
                    <p class="text-sm text-black/70 mt-1">
                        A bank of past OEC prompts, competition packages, rubrics, and competitor briefing slides
                    </p>
                    <div class="mt-4">
                        <Button
                            href="https://drive.google.com/drive/folders/1bqHT3XW5AsZEfDbceDHjrCpmAd9jyRQw"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Download class="w-5 h-5" />
                            View / Download
                        </Button>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
